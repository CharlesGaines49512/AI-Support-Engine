# AI Support Engine
# Environment configuration template
# Copy this file to .env for local development.

# Application configuration
APP_NAME="AI Support Engine"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# API configuration
API_V1_PREFIX=/api/v1

# Logging configuration
LOG_LEVEL=INFO

# External service configuration
REQUEST_TIMEOUT=30.0
MAX_RETRIES=3

# PostgreSQL database configuration
POSTGRES_DB=ai_support_engine
POSTGRES_USER=ai_support_user
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Artificial intelligence configuration
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT=30.0
AI_MAX_RETRIES=3
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_INPUT_CHARS=20000

# Optional AI pricing configuration.
# Prices are expressed in USD per one million tokens.
# Configure all four settings using verified provider pricing.
# The model must exactly match the returned response model.
# Leave commented out when pricing is unknown.
# AI_PRICING_MODEL=
# AI_PRICING_INPUT_USD_PER_MILLION=
# AI_PRICING_CACHED_INPUT_USD_PER_MILLION=
# AI_PRICING_OUTPUT_USD_PER_MILLION=

# Application log ingestion limits
LOG_MAX_PAYLOAD_BYTES=1048576
LOG_MAX_ENTRIES=1000
LOG_MAX_NESTING_DEPTH=32
LOG_MAX_MESSAGE_CHARS=10000
LOG_MAX_METADATA_CHARS=500
LOG_MAX_EVIDENCE_ENTRIES=20
LOG_MAX_EVIDENCE_CHARS=8000
